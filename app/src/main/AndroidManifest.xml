<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.google.android.youtube.tv">

    <!-- Permisos necesarios para Android TV y MicroG-RE -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Configuración de locale turco -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="YouTube TV"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.YouTubeTV"
        android:localeDisabled="false">

        <!-- Meta-data para locale turco -->
        <meta-data
            android:name="android.locale"
            android:value="tr-TR"/>

        <!-- Main activity para Android TV -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="YouTube TV">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>

    </application>

</manifest>